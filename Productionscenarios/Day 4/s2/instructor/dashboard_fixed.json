{
 "uid": "payment-dashboard",
 "title": "Payment Dashboard",
 "tags": [
  "shopnow",
  "tel-d4-402"
 ],
 "timezone": "browser",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "refresh": "10s",
 "schemaVersion": 39,
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Payment Error Volume",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 10
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum(count_over_time({app=\"payment-service\"} | json | level=\"ERROR\" [1m]))",
     "legendFormat": "errors"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 5
       },
       {
        "color": "red",
        "value": 20
       }
      ]
     }
    },
    "overrides": []
   }
  }
 ]
}