# BIND=127.0.0.1 keeps ports on this machine. Set BIND=0.0.0.0 only on a VM you reach from your laptop (and then open ports 3000/9090/9095 to your own IP only).
BIND=127.0.0.1
# Placeholder — change it. Used as the Grafana admin password and by the lab commands (curl -u admin:<password>).
GRAFANA_PASSWORD=admin
